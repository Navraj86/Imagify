PORT=4000
# MongoDB connection string (the "imagify" database is selected automatically)
MONGODB_URI="mongodb+srv://user:password@cluster.example.mongodb.net"
JWT_SECRET="a-long-random-string"
JWT_EXPIRES_IN="7d"
# Clipdrop text-to-image API key
CLIPDROP_API="your-clipdrop-api-key"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Currency Razorpay charges in; keep NEXT_PUBLIC_CURRENCY in client/.env the same
CURRENCY="INR"
# Optional: comma-separated frontend origins allowed to call the API (unset allows any)
CLIENT_URL="http://localhost:3000"
